nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("icAdaBipu1 - test pri/alt, phased assembly, mitohifi on contigs, oatk for mito only") {

        setup {
            println "\n\n"
            curlAndExtract("https://tolit.cog.sanger.ac.uk/test-data/resources/busco/eukaryota_busco_odb12.tar.gz", "${launchDir}/")
        }

        when {
            params {
                genomic_data = "${projectDir}/assets/local_tests/icAdaBipu1_genomic.yaml"
                assembly_specs = "${projectDir}/assets/local_tests/icAdaBipu1_spec.yaml"
                outdir = "$outputDir"
				save_fastk_databases = true
				busco_lineage_directory = "${launchDir}/busco/"
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/genomeassembly_software_versions.yml"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path
                ).match() }
            )
        }
    }
}
