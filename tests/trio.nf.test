nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("aBomVar4 - test trio assembly, mitohifi reads") {

        setup {
            print "\n\n\t"
            curlAndExtract("https://tolit.cog.sanger.ac.uk/test-data/resources/busco/eukaryota_busco_odb12.tar.gz", "${launchDir}/")
        }

        when {
            params {
                genomic_data = "${projectDir}/assets/local_tests/aBomVar4_genomic.yaml"
                assembly_specs = "${projectDir}/assets/local_tests/aBomVar4_spec.yaml"
                outdir = "$outputDir"
                busco_lineage_directory = "${launchDir}/busco/"
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(
                params.outdir,
                relative: true,
                includeDir: true,
                ignore: [
                    'pipeline_info/*.{html,json,txt}',
                    '**/{mito,plastid,*.mitohifi}/{contigs_circularization}/**'
                    '**/{mito,plastid,*.mitohifi}/{contigs_filtering}/**'
                    '**/{mito,plastid,*.mitohifi}/{potential_contigs}/**'
                    '**/{mito,plastid,*.mitohifi}/{reads_mapping_and_assembly}/**'
                    '**/{mito,plastid,*.mitohifi}/{final_mitogenome_choice}/**'
                ]
            )
            // stable_content: All files in ${params.outdir}/ with stable content
            def stable_content = getAllFilesFromDir(
                params.outdir,
                ignoreFile: 'tests/.nftignore'
            )
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/genomeassembly_software_versions.yml"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_content
                ).match() }
            )
        }
    }
}
