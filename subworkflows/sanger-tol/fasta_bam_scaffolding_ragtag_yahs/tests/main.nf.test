
nextflow_workflow {

    name "Test Subworkflow FASTA_BAM_SCAFFOLDING_RAGTAG_YAHS"
    script "../main.nf"
    workflow "FASTA_BAM_SCAFFOLDING_RAGTAG_YAHS"

    tag "subworkflows"
    tag "subworkflows_sangertol"
    tag "subworkflows/fasta_bam_scaffolding_ragtag_yahs"

    tag "bedtools/bamtobedsort"
    tag "yahs/makepairsfile"
    tag "modules/nf-core/samtools/view"
    tag "subworkflows/../../modules/nf-core/yahs"
    tag "subworkflows/../../modules/nf-core/samtools/faidx"
    tag "subworkflows/../../modules/nf-core/ragtag/scaffold"

    config "./nextflow.config"

    setup {
        nfcoreInitialise("${launchDir}/../library/")
        nfcoreInstall(
            "${launchDir}/../library/",
            [
                "samtools/faidx",
                "yahs",
                "ragtag/scaffold"
            ]
        )
        nfcoreLink("${launchDir}/../library/", "${baseDir}/modules/")
    }

    test("Undibacterium_unclassified - bam - minimap2") {

        when {

            params {
                bamtobedsort_view_args = "-u"
                bamtobedsort_sort_args = "-k4,4"
                ragtag_args            = "-u"
            }

            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'Undibacterium_unclassified/assembly/draft/baUndUnlc1.hic.hap1.p_ctg.fa', checkIfExists: true)
                ])
                input[1] = channel.of([
                    [id: "test"],
                    file(params.modules_testdata_base_path + "Undibacterium_unclassified/analysis/hic_mapping/41741_2.7.sub.cram.baUndUnlc1_hic_phased_hap1.3.bam")
                ])
                input[2] = channel.of([
                    [id: "test"],
                    file(params.modules_testdata_base_path + "Undibacterium_unclassified/assembly/draft/baUndUnlc1.hic.hap1.p_ctg.unscaffolded.fa")
                ])
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert snapshot(sanitizeOutput(workflow.out, unstableKeys: ["yahs_log", "ragtag_delta"])).match() }
            )
        }
    }

    test("Undibacterium_unclassified - bam - nucmer") {

        when {

            params {
                bamtobedsort_view_args = "-u"
                bamtobedsort_sort_args = "-k4,4"
                ragtag_args            = "-u --aligner nucmer"
            }

            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'Undibacterium_unclassified/assembly/draft/baUndUnlc1.hic.hap1.p_ctg.fa', checkIfExists: true)
                ])
                input[1] = channel.of([
                    [id: "test"],
                    file(params.modules_testdata_base_path + "Undibacterium_unclassified/analysis/hic_mapping/41741_2.7.sub.cram.baUndUnlc1_hic_phased_hap1.3.bam")
                ])
                input[2] = channel.of([
                    [id: "test"],
                    file(params.modules_testdata_base_path + "Undibacterium_unclassified/assembly/draft/baUndUnlc1.hic.hap1.p_ctg.unscaffolded.fa")
                ])
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert snapshot(sanitizeOutput(workflow.out, unstableKeys: ["yahs_log", "ragtag_delta"])).match() }
            )
        }
    }

}
