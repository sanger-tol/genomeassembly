params {
    syncon_decon_args = ""
}

process {
    withName: SYNCON_BUILD_READS {
        ext.prefix = "reads"
    }
    withName: SYNCON_DECON {
        ext.args   = { "${params.syncon_decon_args}" }
        ext.prefix = { "${meta.id}_${meta._hap}" }
    }
    withName: SYNCON_FETCH {
        ext.prefix = { "${meta.id}_${meta._hap}" }
    }
}
