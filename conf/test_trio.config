/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run sanger-tol/genomeassembly -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {

    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '6.h'
    ]

}

params {

    config_profile_name        = 'Test profile - trio assembly'
    config_profile_description = 'Minimal test dataset to check trio assembly functionality and mitohifi assembly from reads'

    // Input data
    genomic_data = "${projectDir}/assets/local_tests/aBomVar4_genomic.yaml"
    assembly_specs = "${projectDir}/assets/local_tests/aBomVar4_spec.yaml"

}
