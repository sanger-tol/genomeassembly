nextflow_process {

    name "Test Process FASTXALIGN_MINIMAP2ALIGN"
    script "../main.nf"
    process "FASTXALIGN_MINIMAP2ALIGN"

    tag "modules"
    tag "modules_sangertol"
    tag "fastxalign"
    tag "fastxalign/pyfastxindex"
    tag "fastxalign/minimap2align"

    config "./nextflow.config"

    setup {
        run("FASTXALIGN_PYFASTXINDEX") {
            script "../../pyfastxindex/main.nf"
            process {
                """
                input[0] = channel.of([
                    [ id: "test" ],
                    file(params.modules_testdata_base_path + 'Undibacterium_unclassified/genomic_data/baUndUnlc1/pacbio/fasta/HiFi.reads.fasta', checkIfExists: true)
                ])
                """
            }
        }
    }

    test("Undibacterium_unclassified - fasta - bam out - no filter") {

        when {

            params {
                minimap2_args      = "-x map-hifi"
                samtools_view_args = ""
                samtools_sort_args = "--write-index -l1"
            }

            process {
                """
                input[0] = FASTXALIGN_PYFASTXINDEX.out.index.map { meta, fasta, fxi, n_reads -> [ meta, fasta, fxi, [] ] }
                input[1] = channel.of([
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'Undibacterium_unclassified/assembly/draft/baUndUnlc1.hic.hap1.p_ctg.fa.gz', checkIfExists: true),
                    []
                ])
                input[2] = channel.of([
                    0,
                    [0, 500],
                ])
                input[3] = true
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    bam(process.out.bam.get(0).get(1)).getStatistics(),
                    process.out.findAll { key, val -> key.startsWith("versions")}
                    ).match()
                }
            )
        }
    }

    test("Undibacterium_unclassified - fasta - bam out - filter") {

        when {

            params {
                minimap2_args      = "-x map-hifi"
                samtools_view_args = "-F 0x904"
                samtools_sort_args = "--write-index -l1"
            }

            process {
                """
                input[0] = FASTXALIGN_PYFASTXINDEX.out.index.map { meta, fasta, fxi, n_reads -> [ meta, fasta, fxi, [] ] }
                input[1] = channel.of([
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'Undibacterium_unclassified/assembly/draft/baUndUnlc1.hic.hap1.p_ctg.fa.gz', checkIfExists: true),
                    []
                ])
                input[2] = channel.of([
                    0,
                    [0, 500],
                ])
                input[3] = true
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    bam(process.out.bam.get(0).get(1)).getStatistics(),
                    process.out.findAll { key, val -> key.startsWith("versions")}
                    ).match()
                }
            )
        }
    }

    test("Undibacterium_unclassified - fasta - paf out") {

        when {

            params {
                minimap2_args      = "-x map-hifi"
                samtools_view_args = ""
                samtools_sort_args = ""
            }

            process {
                """
                input[0] = FASTXALIGN_PYFASTXINDEX.out.index.map { meta, fasta, fxi, n_reads -> [ meta, fasta, fxi, [] ] }
                input[1] = channel.of([
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'Undibacterium_unclassified/assembly/draft/baUndUnlc1.hic.hap1.p_ctg.fa.gz', checkIfExists: true),
                    []
                ])
                input[2] = channel.of([
                    0,
                    [0, 500],
                ])
                input[3] = false
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("sarscov2 - bam - stub") {

        options "-stub"

        when {

            params {
                minimap2_args      = ""
                samtools_view_args = ""
                samtools_sort_args = ""
            }

            process {
                """
                input[0] = FASTXALIGN_PYFASTXINDEX.out.index.map { meta, fasta, fxi, n_reads -> [ meta, fasta, fxi, [] ] }
                input[1] = channel.of([
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'Undibacterium_unclassified/assembly/draft/baUndUnlc1.hic.hap1.p_ctg.fa.gz', checkIfExists: true),
                    []
                ])
                input[2] = channel.of([
                    0,
                    [0, 500],
                ])
                input[3] = true
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("Undibacterium_unclassified - fasta - bam out - with pg_lines") {

        when {

            params {
                minimap2_args      = "-x map-hifi"
                samtools_view_args = ""
                samtools_sort_args = "--write-index -l1"
            }

            process {
                """
                input[0] = FASTXALIGN_PYFASTXINDEX.out.index.map { meta, fasta, fxi, n_reads -> [
                    meta, fasta, fxi,
                    ['@PG\\\\tID:samtools\\\\tPN:samtools\\\\tVN:1.21\\\\tCL:samtools view -F 0x200 -o filtered.cram input.cram']
                ] }
                input[1] = channel.of([
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'Undibacterium_unclassified/assembly/draft/baUndUnlc1.hic.hap1.p_ctg.fa.gz', checkIfExists: true),
                    []
                ])
                input[2] = channel.of([
                    0,
                    [0, 500],
                ])
                input[3] = true
                """
            }
        }

        then {
            def strip_absolute_path_lines = { text ->
                def lines = text?.getClass()?.isArray()
                    ? text.toList()
                    : (text instanceof Collection ? text : (text?.toString()?.readLines() ?: []))
                lines
                    .collect { line ->
                        line.toString()
                            .replaceAll(/\bUR:\/(?:[^\/\s]+\/)*([^\/\s]+)/, 'UR:$1')
                    }
            }
            assertAll(
                { assert process.success },
                { assert snapshot(
                    bam(process.out.bam.get(0).get(1)).getStatistics(),
                    process.out.bam.collect { meta, f -> [(new File(f.toString()).getName()): strip_absolute_path_lines(bam(f.toString()).getHeader())] }.collectEntries { it }.sort(),
                    process.out.findAll { key, val -> key.startsWith("versions")}
                    ).match()
                }
            )
        }
    }

}
